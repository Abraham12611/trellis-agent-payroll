{
  "name": "trellis-agent-payroll",
  "version": "1.0.0",
  "description": "Agent Payroll & Compliance OS for Tempo Blockchain",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "cli",
    "sdk"
  ],
  "scripts": {
    "simulate:onboarding": "node scripts/01-agent-onboarding.js",
    "simulate:payroll": "node scripts/02-batch-payroll.js",
    "simulate:compliance": "node scripts/03-compliance-check.js",
    "simulate:tasks": "node scripts/04-agent-tasks.js",
    "simulate:full": "node scripts/05-full-workflow.js",
    "deploy:contracts": "hardhat run scripts/deploy.js --network moderato",
    "test": "hardhat test",
    "compile": "hardhat compile",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:cli": "cd cli && npm run dev",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../cli && npm install && cd ../sdk && npm install",
    "build:all": "npm run compile && cd sdk && npm run build && cd ../cli && npm run build",
    "start:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "keywords": [
    "tempo",
    "blockchain",
    "payroll",
    "ai-agents",
    "compliance",
    "tip-20",
    "web3"
  ],
  "author": "Trellis Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "ora": "^5.4.1"
  }
}
